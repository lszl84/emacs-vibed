+/* VIBED synthetic touchpad: inject GDK smooth scroll events at a fixed
+   rate, catching up in bursts when Emacs was busy (like events queued
+   in the Wayland socket).  Segments: list of (DELTA-Y SECONDS), where
+   DELTA-Y 0 means a pause.  A scroll-stop event ends each segment.  */
+static struct {
+  GtkWidget *widget; GdkDevice *device, *source;
+  double rate, start, seg_start; long sent; guint id;
+  double segs[64][2]; int nsegs, seg; double ends[64]; int nends;
+} vibed_inj;
+
+static void
+vibed_put_scroll (double dy, bool stop)
+{
+  GdkEvent *ev = gdk_event_new (GDK_SCROLL);
+  GdkWindow *win = gtk_widget_get_window (vibed_inj.widget);
+  ev->scroll.window = g_object_ref (win);
+  ev->scroll.send_event = FALSE;
+  ev->scroll.time = (guint32) (vibed_now () * 1000);
+  ev->scroll.x = gtk_widget_get_allocated_width (vibed_inj.widget) / 2;
+  ev->scroll.y = gtk_widget_get_allocated_height (vibed_inj.widget) / 2;
+  ev->scroll.direction = GDK_SCROLL_SMOOTH;
+  ev->scroll.delta_x = 0;
+  ev->scroll.delta_y = dy;
+  ev->scroll.is_stop = stop;
+  gdk_event_set_device (ev, vibed_inj.device);
+  gdk_event_set_source_device (ev, vibed_inj.source);
+  gdk_display_put_event (gdk_window_get_display (win), ev);
+  gdk_event_free (ev);
+}
+
+static gboolean
+vibed_inject_tick (gpointer data)
+{
+  double now = vibed_now ();
+  while (vibed_inj.seg < vibed_inj.nsegs)
+    {
+      double dy = vibed_inj.segs[vibed_inj.seg][0];
+      double dur = vibed_inj.segs[vibed_inj.seg][1];
+      double seg_end = vibed_inj.seg_start + dur;
+      long due = (long) ((MIN (now, seg_end) - vibed_inj.seg_start)
+			 * vibed_inj.rate);
+      if (dy != 0)
+	for (; vibed_inj.sent < due; vibed_inj.sent++)
+	  vibed_put_scroll (dy, false);
+      if (now < seg_end)
+	return G_SOURCE_CONTINUE;
+      if (dy != 0)
+	{
+	  vibed_put_scroll (0, true);
+	  vibed_inj.ends[vibed_inj.nends++] = seg_end;
+	}
+      vibed_inj.seg++;
+      vibed_inj.sent = 0;
+      vibed_inj.seg_start = seg_end;
+    }
+  vibed_inj.id = 0;
+  return G_SOURCE_REMOVE;
+}
+
+DEFUN ("vibed-inject-scroll", Fvibed_inject_scroll, Svibed_inject_scroll, 2, 2, 0,
+       doc: /* Inject synthetic touchpad scrolling at RATE Hz; SEGS is ((DY SECS)...).
+With RATE nil, return the list of segment end times and whether done.  */)
+  (Lisp_Object rate, Lisp_Object segs)
+{
+  if (NILP (rate))
+    {
+      Lisp_Object r = Qnil;
+      for (int i = vibed_inj.nends - 1; i >= 0; i--)
+	r = Fcons (make_float (vibed_inj.ends[i]), r);
+      return Fcons (vibed_inj.id ? Qnil : Qt, r);
+    }
+  struct frame *f = SELECTED_FRAME ();
+  vibed_inj.widget = FRAME_GTK_WIDGET (f);
+  GdkSeat *seat = gdk_display_get_default_seat (gtk_widget_get_display (vibed_inj.widget));
+  vibed_inj.device = gdk_seat_get_pointer (seat);
+  vibed_inj.source = vibed_inj.device;
+  GList *slaves = gdk_seat_get_slaves (seat, GDK_SEAT_CAPABILITY_ALL_POINTING);
+  for (GList *l = slaves; l; l = l->next)
+    if (gdk_device_get_source (l->data) == GDK_SOURCE_TOUCHPAD)
+      vibed_inj.source = l->data;
+  g_list_free (slaves);
+  vibed_inj.rate = XFLOATINT (rate);
+  vibed_inj.nsegs = 0;
+  for (Lisp_Object t = segs; CONSP (t) && vibed_inj.nsegs < 64; t = XCDR (t))
+    {
+      vibed_inj.segs[vibed_inj.nsegs][0] = XFLOATINT (XCAR (XCAR (t)));
+      vibed_inj.segs[vibed_inj.nsegs][1] = XFLOATINT (XCAR (XCDR (XCAR (t))));
+      vibed_inj.nsegs++;
+    }
+  vibed_inj.seg = 0; vibed_inj.sent = 0; vibed_inj.nends = 0;
+  vibed_inj.seg_start = vibed_now ();
+  if (!vibed_inj.id)
+    vibed_inj.id = g_timeout_add (1, vibed_inject_tick, NULL);
+  return build_string (gdk_device_get_name (vibed_inj.source));
+}
+
+DEFUN ("vibed-stats", Fvibed_stats, Svibed_stats, 0, 1, 0,
+       doc: /* Return VIBED instrumentation counters; reset them if RESET.  */)
+  (Lisp_Object reset)
+{
+  Lisp_Object times = make_nil_vector (vibed_st.ndt);
+  Lisp_Object tl = make_nil_vector (vibed_st.ntl);
+  for (long i = 0; i < vibed_st.ntl; i++)
+    ASET (tl, i, Fcons (make_float (vibed_st.tl_time[i]),
+			make_fixnum (vibed_st.tl_type[i])));
+  for (long i = 0; i < vibed_st.ndt; i++)
+    ASET (times, i, make_float (vibed_st.draw_times[i]));
+  Lisp_Object r
+    = list (QCvibed_updates, make_fixnum (vibed_st.updates),
+	    QCvibed_update_ms, make_float (vibed_st.t_update * 1000),
+	    QCvibed_copies, make_fixnum (vibed_st.copies),
+	    QCvibed_copy_ms, make_float (vibed_st.t_copy * 1000),
+	    QCvibed_uptodate, make_fixnum (vibed_st.uptodate),
+	    QCvibed_draws, make_fixnum (vibed_st.draws),
+	    QCvibed_draw_ms, make_float (vibed_st.t_draw * 1000),
+	    QCvibed_draw_area, make_float (vibed_st.draw_area),
+	    QCvibed_surftype, make_fixnum (vibed_st.surftype),
+	    QCvibed_draw_times, times,
+	    QCvibed_timeline, tl);
+  if (!NILP (reset))
+    memset (&vibed_st, 0, sizeof vibed_st);
+  return r;
+}
