+/* VIBED instrumentation (measurement only, not part of the patch).  */
+#include <time.h>
+static double vibed_now (void)
+{
+  struct timespec ts; clock_gettime (CLOCK_REALTIME, &ts);
+  return ts.tv_sec + ts.tv_nsec * 1e-9;
+}
+static struct {
+  long updates, copies, uptodate, draws, surftype;
+  double t_update, t_copy, t_draw, draw_area, upd_t0;
+  double draw_times[16384]; long ndt;
+  double tl_time[65536]; char tl_type[65536]; long ntl;
+} vibed_st;
+static void vibed_tl (char type)
+{
+  if (vibed_st.ntl < 65536)
+    {
+      vibed_st.tl_time[vibed_st.ntl] = vibed_now ();
+      vibed_st.tl_type[vibed_st.ntl++] = type;
+    }
+}
