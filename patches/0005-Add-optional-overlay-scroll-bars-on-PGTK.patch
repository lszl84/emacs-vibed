+/* Watcher for `pgtk-overlay-scroll-bars': replace the scroll bars of
+   all frames, and give them room or take it away.  */
+
+static Lisp_Object
+watch_pgtk_overlay_scroll_bars (Lisp_Object symbol, Lisp_Object newval,
+				Lisp_Object operation, Lisp_Object where)
+{
+  Lisp_Object tail, frame;
+
+  /* Ignore buffer-local bindings.  */
+  if (!NILP (where))
+    return Qnil;
+
+  /* The variable is set after the watchers run, but the scroll bar
+     width computed below depends on it.  */
+  pgtk_overlay_scroll_bars = !NILP (newval);
+
+  FOR_EACH_FRAME (tail, frame)
+    {
+      struct frame *f = XFRAME (frame);
+
+      if (!FRAME_PGTK_P (f) || !FRAME_LIVE_P (f))
+	continue;
+
+      /* Redisplay recreates the scroll bars in the new style.  */
+      block_input ();
+      pgtk_condemn_scroll_bars (f);
+      pgtk_judge_scroll_bars (f);
+      unblock_input ();
+
+      /* Go back to the default width, which is 0 for overlay scroll
+	 bars.  */
+      Fmodify_frame_parameters (frame, list1 (Fcons (Qscroll_bar_width,
+						      Qnil)));
+      SET_FRAME_GARBAGED (f);
+    }
+
+  return Qnil;
+}
