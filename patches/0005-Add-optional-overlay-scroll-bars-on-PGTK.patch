+/* Overlay scroll bars (`pgtk-overlay-scroll-bars').  The vertical
+   scroll bar takes no room in the window: it floats over the right
+   edge of the window's text, styled like the overlay scroll bars of
+   GTK's scrolled windows, and is shown only while the window scrolls
+   or the pointer is near it.  */
+
+/* Milliseconds the bar stays after the last activity, and the length
+   and number of the steps in which it then fades out.  */
+#define OVERLAY_SCROLL_BAR_DELAY 1000
+#define OVERLAY_SCROLL_BAR_FADE_INTERVAL 20
+#define OVERLAY_SCROLL_BAR_FADE_STEPS 10
+
+/* Show the bar when the pointer is this many pixels from it.  */
+#define OVERLAY_SCROLL_BAR_PROXIMITY 24
+
+struct overlay_scroll_bar
+{
+  /* Timer that fades the bar out, or 0.  */
+  guint timer;
+  int fade_step;
+  bool hovering, dragging;
+};
+
+static struct overlay_scroll_bar *
+overlay_scroll_bar_state (GtkWidget *wscroll)
+{
+  return g_object_get_data (G_OBJECT (wscroll), "emacs-overlay-scroll-bar");
+}
+
+static void
+overlay_scroll_bar_free (gpointer data)
+{
+  struct overlay_scroll_bar *o = data;
+
+  if (o->timer)
+    g_source_remove (o->timer);
+  g_free (o);
+}
+
+static gboolean
+overlay_scroll_bar_fade (gpointer data)
+{
+  GtkWidget *wscroll = data;
+  struct overlay_scroll_bar *o = overlay_scroll_bar_state (wscroll);
+
+  if (++o->fade_step < OVERLAY_SCROLL_BAR_FADE_STEPS)
+    {
+      gtk_widget_set_opacity (wscroll,
+			      1.0 - ((double) o->fade_step
+				     / OVERLAY_SCROLL_BAR_FADE_STEPS));
+      return G_SOURCE_CONTINUE;
+    }
+
+  /* Hide the bar, so that it doesn't take clicks meant for the text
+     below it.  */
+  gtk_widget_hide (gtk_widget_get_parent (wscroll));
+  gtk_widget_set_opacity (wscroll, 1.0);
+  o->timer = 0;
+  return G_SOURCE_REMOVE;
+}
+
+static gboolean
+overlay_scroll_bar_start_fade (gpointer data)
+{
+  struct overlay_scroll_bar *o = overlay_scroll_bar_state (data);
+
+  o->fade_step = 0;
+  o->timer = g_timeout_add (OVERLAY_SCROLL_BAR_FADE_INTERVAL,
+			    overlay_scroll_bar_fade, data);
+  return G_SOURCE_REMOVE;
+}
+
+/* Show the overlay scroll bar WSCROLL, and hide it again after a
+   while unless the pointer is on it.  */
+
+static void
+overlay_scroll_bar_reveal (GtkWidget *wscroll)
+{
+  struct overlay_scroll_bar *o = overlay_scroll_bar_state (wscroll);
+  gint width, height, min_slider_length;
+
+  if (!o)
+    return;
+
+  if (o->timer)
+    {
+      g_source_remove (o->timer);
+      o->timer = 0;
+    }
+
+  /* xg_update_scrollbar_pos hides bars that don't fit.  */
+  gtk_widget_get_size_request (wscroll, &width, &height);
+  gtk_widget_style_get (wscroll, "min-slider-length", &min_slider_length,
+			NULL);
+  if (height < min_slider_length)
+    return;
+
+  gtk_widget_set_opacity (wscroll, 1.0);
+  gtk_widget_show_all (gtk_widget_get_parent (wscroll));
+
+  if (!o->hovering && !o->dragging)
+    o->timer = g_timeout_add (OVERLAY_SCROLL_BAR_DELAY,
+			      overlay_scroll_bar_start_fade, wscroll);
+}
+
+static gboolean
+overlay_scroll_bar_crossing (GtkWidget *wscroll, GdkEventCrossing *event,
+			     gpointer data)
+{
+  struct overlay_scroll_bar *o = overlay_scroll_bar_state (wscroll);
+  GtkStyleContext *ctxt = gtk_widget_get_style_context (wscroll);
+
+  o->hovering = event->type == GDK_ENTER_NOTIFY;
+  if (o->hovering)
+    gtk_style_context_add_class (ctxt, "hovering");
+  else
+    gtk_style_context_remove_class (ctxt, "hovering");
+  overlay_scroll_bar_reveal (wscroll);
+  return FALSE;
+}
+
+static gboolean
+overlay_scroll_bar_button (GtkWidget *wscroll, GdkEventButton *event,
+			   gpointer data)
+{
+  struct overlay_scroll_bar *o = overlay_scroll_bar_state (wscroll);
+  GtkStyleContext *ctxt = gtk_widget_get_style_context (wscroll);
+
+  o->dragging = event->type != GDK_BUTTON_RELEASE;
+  if (o->dragging)
+    gtk_style_context_add_class (ctxt, "dragging");
+  else
+    gtk_style_context_remove_class (ctxt, "dragging");
+  overlay_scroll_bar_reveal (wscroll);
+  return FALSE;
+}
+
+/* Make the vertical scroll bar WSCROLL, inside the event box WEBOX, an
+   overlay scroll bar.  Called by xg_finish_scroll_bar_creation before
+   WEBOX is realized.  */
+
+void
+pgtk_setup_overlay_scroll_bar (GtkWidget *webox, GtkWidget *wscroll)
+{
+  struct overlay_scroll_bar *o = g_new0 (struct overlay_scroll_bar, 1);
+
+  g_object_set_data_full (G_OBJECT (wscroll), "emacs-overlay-scroll-bar",
+			  o, overlay_scroll_bar_free);
+
+  /* Draw the bar over the frame's contents, without a background of
+     its own, using the theme's style for overlay scroll bars.  */
+  gtk_event_box_set_visible_window (GTK_EVENT_BOX (webox), FALSE);
+  gtk_style_context_add_class (gtk_widget_get_style_context (wscroll),
+			       "overlay-indicator");
+
+  gtk_widget_add_events (wscroll, (GDK_ENTER_NOTIFY_MASK
+				   | GDK_LEAVE_NOTIFY_MASK
+				   | GDK_BUTTON_PRESS_MASK
+				   | GDK_BUTTON_RELEASE_MASK));
+  g_signal_connect (G_OBJECT (wscroll), "enter-notify-event",
+		    G_CALLBACK (overlay_scroll_bar_crossing), NULL);
+  g_signal_connect (G_OBJECT (wscroll), "leave-notify-event",
+		    G_CALLBACK (overlay_scroll_bar_crossing), NULL);
+  g_signal_connect (G_OBJECT (wscroll), "button-press-event",
+		    G_CALLBACK (overlay_scroll_bar_button), NULL);
+  g_signal_connect (G_OBJECT (wscroll), "button-release-event",
+		    G_CALLBACK (overlay_scroll_bar_button), NULL);
+}
+
+/* Show the overlay scroll bar of the window of F at X, Y if the
+   pointer is near it.  */
+
+static void
+pgtk_overlay_scroll_bar_pointer (struct frame *f, double x, double y)
+{
+  Lisp_Object window
+    = window_from_coordinates (f, x, y, 0, false, false, false);
+  struct scroll_bar *bar;
+  GtkWidget *wscroll;
+
+  if (!WINDOWP (window) || NILP (XWINDOW (window)->vertical_scroll_bar))
+    return;
+
+  bar = XSCROLL_BAR (XWINDOW (window)->vertical_scroll_bar);
+  if (x >= bar->left - OVERLAY_SCROLL_BAR_PROXIMITY
+      && x < bar->left + bar->width + OVERLAY_SCROLL_BAR_PROXIMITY
+      && y >= bar->top && y < bar->top + bar->height)
+    {
+      wscroll = xg_get_scroll_bar_widget (f, bar->x_window);
+      if (wscroll)
+	overlay_scroll_bar_reveal (wscroll);
+    }
+}
