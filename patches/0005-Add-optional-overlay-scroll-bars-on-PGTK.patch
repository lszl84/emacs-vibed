   Vpgtk_keysym_table = make_hash_table (&hashtest_eql, 900, Weak_None);
 
+  DEFVAR_BOOL ("pgtk-overlay-scroll-bars", pgtk_overlay_scroll_bars,
+    doc: /* Non-nil means vertical scroll bars float over the text.
+When this is non-nil, vertical scroll bars take no room in the
+window.  Each is drawn over the edge of its window's text, in the style
+of GTK's overlay scroll bars, while the window scrolls and while the
+pointer is near it, and fades out after a second.  Setting this
+variable affects all frames, and resets their `scroll-bar-width'
+parameter to the default.  */);
+  pgtk_overlay_scroll_bars = false;
+  DEFSYM (Qpgtk_overlay_scroll_bars, "pgtk-overlay-scroll-bars");
+  {
+    Lisp_Object watcher;
+    static union Aligned_Lisp_Subr Swatch_pgtk_overlay_scroll_bars =
+      {{{ PSEUDOVECTOR_FLAG | (PVEC_SUBR << PSEUDOVECTOR_AREA_BITS) },
